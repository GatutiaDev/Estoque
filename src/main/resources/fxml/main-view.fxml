<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.MainController"
            prefHeight="600" prefWidth="960">

    <top>
        <VBox spacing="10" styleClass="painel-formulario">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label text="Estoque" styleClass="titulo"/>

            <GridPane hgap="10" vgap="10">
                <TextField fx:id="campoProduto" promptText="Produto" prefWidth="240"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="campoCategoria" promptText="Categoria" prefWidth="180"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <ComboBox fx:id="campoMarca" promptText="Marca" prefWidth="120"
                          GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="campoQuantidade" promptText="Quantidade" prefWidth="100"
                           GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                <TextField fx:id="campoCaixa" promptText="Caixa" prefWidth="70"
                           GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                <DatePicker fx:id="campoVencimento" promptText="Vencimento" prefWidth="140"
                            GridPane.rowIndex="0" GridPane.columnIndex="5"/>
            </GridPane>

            <HBox spacing="10">
                <Button fx:id="botaoSalvar" text="Salvar" defaultButton="true" styleClass="botao-principal" onAction="#aoClicarSalvar"/>
                <Button fx:id="botaoLimpar" text="Limpar" onAction="#aoClicarLimpar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra-busca">
                <padding>
                    <Insets top="10" right="16" bottom="10" left="16"/>
                </padding>
                <TextField fx:id="campoBusca" promptText="Buscar produto..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="filtroCategoria" prefWidth="200"/>
                <ComboBox fx:id="filtroMarca" prefWidth="160"/>
                <Button text="Limpar busca" onAction="#aoClicarLimparBusca"/>
            </HBox>
            <TableView fx:id="tabelaEstoque" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label fx:id="labelTabelaVazia" text="Nenhum produto cadastrado ainda."/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colunaProduto" text="Produto" prefWidth="260"/>
                    <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="170"/>
                    <TableColumn fx:id="colunaMarca" text="Marca" prefWidth="100"/>
                    <TableColumn fx:id="colunaQuantidade" text="Quantidade" prefWidth="100"/>
                    <TableColumn fx:id="colunaCaixa" text="Caixa" prefWidth="80"/>
                    <TableColumn fx:id="colunaVencimento" text="Vencimento" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Button text="Editar selecionado" onAction="#aoClicarEditar"/>
            <Button text="−1" styleClass="botao-quantidade" onAction="#aoClicarDiminuir"/>
            <Button text="+1" styleClass="botao-quantidade" onAction="#aoClicarAumentar"/>
            <Button text="Excluir selecionado" styleClass="botao-perigo" onAction="#aoClicarExcluir"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="● Vencido" styleClass="legenda-vencido"/>
            <Label text="● Vence em até 6 meses" styleClass="legenda-vencendo"/>
            <Label fx:id="labelTotal" styleClass="total"/>
        </HBox>
    </bottom>

</BorderPane>
